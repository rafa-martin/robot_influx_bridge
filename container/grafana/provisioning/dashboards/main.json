        {
          "query": "voltage = from(bucket: \"mybucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"battery_state\")\n  |> filter(fn: (r) => r[\"_field\"] == \"voltage\")\n  |> filter(fn: (r) => r[\"cell_id\"] == \"all\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n\ncurrent = from(bucket: \"mybucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"battery_state\")\n  |> filter(fn: (r) => r[\"_field\"] == \"current\")\n  |> filter(fn: (r) => r[\"cell_id\"] == \"all\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n\njoin(\n  tables: {voltage: voltage, current: current},\n  on: [\"_time\", \"_measurement\", \"cell_id\"]\n)\n  |> map(fn: (r) => ({\n      _time:        r._time,\n      _measurement: r._measurement,\n      cell_id:      r.cell_id,\n      _field:       \"power_watts\",\n      _value:       r._value_voltage * r._value_current\n  }))\n  |> yield(name: \"power_watts\")",
          "refId": "A"
        }
      ],
      "title": "Power",
      "type": "timeseries"
