<?xml version="1.0"?>
<?xml-model
    href="http://download.ros.org/schema/package_format3.xsd"
    schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_influx_bridge</name>
  <version>0.0.0</version>
  <description>
    Robotnik common software for ROS2 packages.
  </description>
  <maintainer email="theverbat@gmail.com">Rafael Martín</maintainer>
  <license>BSD-3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>generate_parameter_library</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>rclcpp_components</build_depend>
  <build_depend>diagnostic_msgs</build_depend>
  <build_depend>diagnostic_updater</build_depend>
  <build_depend>builtin_interfaces</build_depend>
  <build_depend>curl</build_depend>
  <build_depend>zlib</build_depend>

  <exec_depend>pluginlib</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>curl</exec_depend>
  <exec_depend>zlib</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
